# Copy to .env and fill in before deploying.

# Lead delivery. Get a free access key from https://web3forms.com (enquiries are
# emailed to the address you verify there). Without this, forms fall back to
# opening the visitor's mail app, which loses most leads on mobile.
VITE_WEB3FORMS_KEY=

# Optional: use a custom form backend instead of Web3Forms.
VITE_FORM_ENDPOINT=

# Public site URL, used for canonical URLs and social share previews.
VITE_SITE_URL=https://www.vidyageomatics.com

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX).
VITE_GA_ID=
